# Application Environment (development, staging, production)
ENVIRONMENT=development

# LLM Configuration (Required)
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret (Required - must be at least 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=super-secret-text-to-sql-token-2026-replace-in-prod

# Database Connection (Required)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=text_to_sql

# Connection Pooling (Optional, defaults shown)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Security & Guardrail Limits (Optional, defaults shown)
MAX_SQL_ROW_LIMIT=50
MAX_RESULT_CHARS=4000
RATE_LIMIT_CHAT=20/minute

# Production Secret File Paths (Docker / Kubernetes Secret Mounts)
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# GOOGLE_API_KEY_FILE=/run/secrets/google_api_key
# DB_PASSWORD_FILE=/run/secrets/db_password
