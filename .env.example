# ==============================================================================
# Environment Configuration for Enterprise Text-to-SQL RAG Chatbot
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development

# Google Gemini API Key (Required for LLM generation & Gemini embeddings in production)
# Get a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret (Required - must be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=super-secret-text-to-sql-token-2026-replace-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Primary Database - Read/Write App Engine (users & chat_logs)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=text_to_sql

# Dedicated Read-Only Query Engine (Chatbot Query Execution User)
# Created via scripts/create_readonly_user.sql with SELECT-only grants on business tables
QUERY_DB_USER=chatbot_readonly
QUERY_DB_PASSWORD=readonly_secret_pass

# Connection Pooling Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Read-Only Query Session Hardening (milliseconds)
QUERY_MAX_EXECUTION_TIME_MS=5000

# Security Guard & Row Clamping Bounds
MAX_SQL_ROW_LIMIT=50
MAX_RESULT_CHARS=4000
MAX_EXPLAIN_ROWS=10000

# Vector RAG Settings (ChromaDB + Text Embeddings)
TOP_K_TABLES=4
TOP_K_EXAMPLES=3
CHROMA_PERSIST_DIR=data/chroma_db
